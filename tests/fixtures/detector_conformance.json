        {
          "name": "get_weather",
          "arguments": {
            "city": "123"
          }
        }
      ]
    },
    {
      "input": "{\"name\":\"get_weather\",\"arguments\":{\"city\":\"Lima\",\"undeclared\":\"7\"}}",
      "expected": [
        {
          "name": "get_weather",
          "arguments": {
            "city": "Lima",
            "undeclared": "7"
          }
        }
      ]
    },
    {
      "input": "{\"name\":\"get_weather\",\"arguments\":{\"city\":\"Lima\",\"flag\":true}}",
      "expected": [
        {
          "name": "get_weather",
          "arguments": {
            "city": "Lima",
            "flag": true
          }
        }
      ]
    },
    {
      "input": "",
      "expected": null
    },
    {
